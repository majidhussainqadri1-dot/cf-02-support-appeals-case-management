msgid "This workspace displays minimum necessary case projections. Every operation is re-authorized through File 00; WordPress administrator status alone is insufficient."
msgstr "اس انتظامی صفحے میں صرف ضروری مقدماتی معلومات دکھائی جاتی ہیں۔ ہر کارروائی کی فائل 00 کے ذریعے دوبارہ اجازت لی جاتی ہے؛ صرف ورڈپریس منتظم ہونا کافی نہیں۔"

msgid "Support sections"
msgstr "مدد کے انتظامی شعبے"
